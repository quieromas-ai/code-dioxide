# Copy to $DIOXIDE_HOME/.env (default ~/.code-dioxide/.env). Values here are placeholders.
# DIOXIDE_HOME is read from the process environment only (it locates this file); set it there.
# DIOXIDE_HOME=
DIOXIDE_HOST=127.0.0.1
DIOXIDE_PORT=8500
# DIOXIDE_AUTH_TOKEN=
DIOXIDE_AUTH_DISABLED=false
DIOXIDE_TRUST_LOOPBACK=false
DIOXIDE_CLAUDE_BIN=claude
# The orchestrator (lifecycle parent session) needs a capable model with a large context window
# (Opus or Fable at low to medium effort); stages may use cheaper models (set in the agents).
# DIOXIDE_PARENT_MODEL=opus
# DIOXIDE_PARENT_EFFORT=low
# The role-less script stages (setup, merge) only run a fixed command: a cheap model is enough.
# Unset: they run on the parent's model.
# DIOXIDE_SCRIPT_MODEL=haiku
# On a task's first rate limit, swap these agent models once and resume at once (JSON; {} = off).
# DIOXIDE_MODEL_FALLBACK={"fable":"opus"}
# DIOXIDE_CLAUDE_HOME=
# DIOXIDE_DEFAULT_PROJECT_DIR=
# DIOXIDE_MCP_CONFIG_PATH=
